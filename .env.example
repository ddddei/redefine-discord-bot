# Discord Bot
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# Core Channels
LOG_CHANNEL_ID=

# 참여 활동 포인트 MVP local JSON 경로입니다. 비워두면 data/*.local.json 기본값을 사용합니다.
MISSIONS_DATA_PATH=
MISSION_TEMPLATES_DATA_PATH=
SUBMISSIONS_DATA_PATH=
OPERATOR_SUPPORT_DATA_PATH=

# Google Sheets append-only 운영 로그 보조 저장소입니다.
# 기본값은 비활성화입니다. 실제 Web App URL과 secret은 Railway Variables 또는 로컬 .env에만 설정합니다.
GOOGLE_SHEETS_LOGGING_ENABLED=false
GOOGLE_SHEETS_WEB_APP_URL=
GOOGLE_SHEETS_WEB_APP_SECRET=

# Mission / Activity Review
# ACTIVITY_REVIEW_CHANNEL_ID가 비어 있으면 LOG_CHANNEL_ID를 사용합니다.
ACTIVITY_REVIEW_CHANNEL_ID=
TODAY_MISSION_CHANNEL_ID=
DAILY_MISSION_REWARD_POINTS=20
DAILY_MISSION_ANNOUNCEMENT_ENABLED=false
DAILY_MISSION_ANNOUNCEMENT_CHANNEL_ID=
DAILY_MISSION_ANNOUNCEMENT_HOUR=9
MISSION_SUBMISSION_CHANNEL_ID=
MISSION_REACTION_REWARD_POINTS=20
MISSION_APPROVE_EMOJI=✅
MISSION_REJECT_EMOJI=❌
OPERATOR_ROLE_ID=
REACTION_APPROVAL_PUBLIC_REPLY=false
REACTION_APPROVAL_DM_USER=true

# 운영 종료 전 /운영내보내기 확인 리마인더입니다. 파일은 자동 생성하지 않습니다.
OPERATION_BACKUP_REMINDER_ENABLED=false
OPERATION_BACKUP_REMINDER_TIME_KST=20:50

# 운영 데이터 자동 백업입니다. 매일 지정 시각(KST)에 전체 상태 스냅샷 JSON을 채널에 업로드합니다.
# 백업 채널은 반드시 운영진 전용 비공개 채널이어야 합니다(사용자 ID, 인증 원문 포함).
# OPERATION_BACKUP_CHANNEL_ID가 비어 있으면 LOG_CHANNEL_ID를 사용합니다.
OPERATION_BACKUP_AUTO_ENABLED=false
OPERATION_BACKUP_CHANNEL_ID=
OPERATION_BACKUP_TIME_KST=21:00

# Point / Redemption
POINT_REDEEM_CHANNEL_ID=

# Minigames
# 설정하면 미니게임 버튼은 이 채널에서만 실행됩니다.
MINIGAME_CHANNEL_ID=

# 던전월드 미니게임. 캠페인 시작일(YYYY-MM-DD) 기준으로 매주 화요일 다음 회차가 자동으로 열립니다.
# 비워두면 항상 1회차가 열립니다. 운영진은 /던전월드관리 로 수동 오버라이드할 수 있습니다.
DUNGEONWORLD_START_DATE=
DUNGEONWORLD_LOG_PATH=
DUNGEONWORLD_CONFIG_PATH=

# 읽기 전용 관리자 웹 대시보드 MVP입니다.
# 기본값은 비활성화입니다. 실제 비밀번호는 Railway Variables 또는 로컬 .env에만 설정합니다.
ADMIN_DASHBOARD_ENABLED=false
ADMIN_DASHBOARD_PASSWORD=
ADMIN_DASHBOARD_TITLE=리디파인 운영 대시보드

# 민감 질문 운영진 알림을 별도 채널로 보낼 때 사용합니다.
# 비워두면 LOG_CHANNEL_ID를 사용합니다.
# 실제 채널 ID는 로컬 .env 또는 Railway Variables에만 설정하고 커밋하지 않습니다.
SAFETY_ALERT_CHANNEL_ID=

# AI fallback is disabled by default.
# 실제 API Key는 Railway Variables 또는 로컬 .env에만 설정하고 커밋하지 않습니다.
AI_ENABLED=false
AI_PROVIDER=none
AI_MODEL=
AI_MAX_TOKENS=500
AI_LOG_ENABLED=false
OPENAI_API_KEY=
GEMINI_API_KEY=

# DM conversation-practice MVP. 기본값은 비활성화입니다.
DM_CHAT_ENABLED=false
DM_CHAT_HISTORY_LIMIT=8
DM_CHAT_LOG_CHANNEL_ID=
DM_CHAT_LOG_PATH=
